# Build-time variables for the static export. Copy to .env.local for local testing.
# Names only: real values are set by the build server. NEXT_PUBLIC_* values are baked into
# the public files, so never put a secret in one.

# External endpoint that receives the home page pilot request form (JSON POST).
# Provided by the platform team; CORS must allow the site's origin.
NEXT_PUBLIC_FORM_ENDPOINT=
